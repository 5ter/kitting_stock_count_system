include ../mixins/label-card.jade

- const total = labels ? labels.length : 0

if includeCountUpdates
  span#preview-total(class="mt-8 flex items-center gap-2 font-label-xl text-primary border border-primary rounded-full px-6 h-10 hover:bg-surface-container transition-colors" hx-swap-oob="outerHTML")
    | Total: #{totalCount || total} labels

  span#generate-count(hx-swap-oob="outerHTML")
    | Generate #{totalCount || total} Labels

if total === 0
  p(class="text-on-surface-variant text-sm") No labels to preview yet.

else if total === 1
  div(class="flex justify-center w-full py-4")
    div(class="w-full max-w-sm")
      +labelCard(labels[0])
else
  div(class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 w-full")
    each label in labels
      +labelCard(label)
