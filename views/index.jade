extends layout

block content
  //- ===== Top App Bar =====
  header(class="w-full top-0 sticky flex items-center justify-between px-margin-mobile md:px-margin-desktop h-touch-target bg-surface border-b border-outline-variant z-50")
    div(class="flex items-center gap-2")
      span(class="material-symbols-outlined text-primary") warehouse
      h1(class="font-headline-md text-headline-md font-bold text-primary") Label Generator
    nav(class="hidden md:flex gap-4")
      a(class="font-label-md text-label-md flex items-center gap-1 text-primary hover:bg-surface-container transition-colors px-2 py-1 rounded-DEFAULT" href="/")
        span(class="material-symbols-outlined text-[18px]") label
        | Generate
      a(class="font-label-md text-label-md flex items-center gap-1 text-on-surface-variant hover:bg-surface-container transition-colors px-2 py-1 rounded-DEFAULT" href="/history")
        span(class="material-symbols-outlined text-[18px]") history
        | History
      a(class="font-label-md text-label-md flex items-center gap-1 text-on-surface-variant hover:bg-surface-container transition-colors px-2 py-1 rounded-DEFAULT" href="/settings")
        span(class="material-symbols-outlined text-[18px]") settings
        | Settings

  main(class="flex-1 min-h-0 flex flex-col md:flex-row overflow-hidden")
    //- ===== Left panel: live preview grid =====
    //- hx-target/hx-swap on the form (below) point at #preview-grid, which
    //- lives inside this partial so the same fragment can be re-rendered
    //- standalone by /labels/preview and /labels/generate.
    section(class="flex-1 min-h-0 bg-surface-container-low p-margin-mobile md:p-margin-desktop flex flex-col items-center justify-start border-b md:border-b-0 md:border-r border-outline-variant overflow-y-auto")
      div(class="flex flex-col items-center w-full max-w-4xl")
        div#preview-grid(class="w-full flex flex-col items-center gap-6")
          include partials/preview-grid.jade
        span#preview-total(class="mt-8 flex items-center gap-2 font-label-xl text-primary border border-primary rounded-full px-6 h-10 hover:bg-surface-container transition-colors")
          //- span(class="material-symbols-outlined text-[20px]") grid_view
          | Total: #{totalCount || 0} labels

    //- ===== Right panel: configuration form =====
    aside(class="w-full md:w-120 bg-surface flex flex-col h-full overflow-hidden")
      form#label-form(
        class="flex-1 overflow-y-auto p-margin-mobile md:p-margin-desktop space-y-stack-lg"
        hx-post="/labels/preview"
        hx-trigger="change, keyup changed delay:400ms"
        hx-target="#preview-grid"
        hx-swap="innerHTML"
      )
      
        //- Core Parameters
        div
          h3(class="font-label-xl text-label-xl text-on-surface uppercase border-b border-outline-variant pb-2 mb-stack-md") Core Parameters
          div(class="space-y-stack-md")
            div(class="flex flex-col gap-1")
              label(class="font-label-md text-label-md text-on-surface") Plant
              select(name="plant" 
                    required
                    hx-get="/departments" 
                    hx-target="#department" 
                    hx-trigger="change" 
                    hx-swap="innerHTML" class="w-full h-touch-target px-3 border border-outline focus:border-2 focus:border-primary rounded-DEFAULT font-body-md text-body-md bg-surface-container-lowest")
                option(value="" selected) Select a Plant
                each plant in plants
                  option(value=plant)= plant

            div(class="flex flex-col gap-1")
              label(class="font-label-md text-label-md text-on-surface") Department
              select#department(name="department" required class="w-full h-touch-target px-3 border border-outline focus:border-2 focus:border-primary rounded-DEFAULT font-body-md text-body-md bg-surface-container-lowest")
                include partials/department.jade
                  


        //- Shelf Settings Section
        div
          h3(class="font-label-xl text-label-xl text-on-surface uppercase border-b border-outline-variant pb-2 mb-stack-md mt-stack-lg") Shelf Settings
          
          div(class="space-y-stack-md bg-surface-container-low p-4 rounded-DEFAULT border border-outline-variant")
            
            //- Hidden input to serialize shelfMode ('range' | 'single') for Express
            input#shelfMode(
              type="hidden" 
              name="shelfMode" 
              value="single"
            )

            //- Mode Toggle Buttons
            div(class="flex border border-outline rounded-DEFAULT overflow-hidden bg-surface-container-lowest h-10")
              button#btn-shelf-range(
                type="button"
                class="flex-1 font-label-md text-on-surface hover:bg-surface-container transition-colors"
                onclick="setShelfMode('range')"
              ) Range
              
              button#btn-shelf-single(
                type="button"
                class="flex-1 font-label-md bg-primary text-on-primary border-l border-outline"
                onclick="setShelfMode('single')"
              ) Single

            //- Range View (Hidden by default)
            div#shelf-range-view(class="hidden grid grid-cols-3 gap-2 pt-2")
              div(class="flex flex-col gap-1")
                label(class="text-[10px] text-on-surface-variant uppercase font-semibold") Prefix
                input(
                  type="text"
                  name="shelfPrefix"
                  value="C"
                  disabled
                  class="w-full h-touch-target px-2 border border-outline focus:border-2 focus:border-primary rounded-DEFAULT font-body-md text-center bg-surface-container-lowest"
                )
              div(class="flex flex-col gap-1")
                label(class="text-[10px] text-on-surface-variant uppercase font-semibold") Start
                input(
                  type="number"
                  name="shelfStart"
                  value="1"
                  disabled
                  class="w-full h-touch-target px-2 border border-outline focus:border-2 focus:border-primary rounded-DEFAULT font-body-md text-center bg-surface-container-lowest"
                )
              div(class="flex flex-col gap-1")
                label(class="text-[10px] text-on-surface-variant uppercase font-semibold") End
                input(
                  type="number"
                  name="shelfEnd"
                  value="10"
                  disabled
                  class="w-full h-touch-target px-2 border border-outline focus:border-2 focus:border-primary rounded-DEFAULT font-body-md text-center bg-surface-container-lowest"
                )

            //- Single View (Active by default)
            div#shelf-single-view(class="grid grid-cols-2 gap-2 pt-2")
              div(class="flex flex-col gap-1")
                label(class="text-[10px] text-on-surface-variant uppercase font-semibold") Prefix
                input(
                  type="text"
                  name="shelfPrefix"
                  value="C"
                  class="w-full h-touch-target px-2 border border-outline focus:border-2 focus:border-primary rounded-DEFAULT font-body-md text-center bg-surface-container-lowest"
                )
              div(class="flex flex-col gap-1")
                label(class="text-[10px] text-on-surface-variant uppercase font-semibold") Shelf Number
                input(
                  type="number"
                  name="shelfStart"
                  value="1"
                  class="w-full h-touch-target px-2 border border-outline focus:border-2 focus:border-primary rounded-DEFAULT font-body-md text-center bg-surface-container-lowest"
                )

                //- Minimal JS helper to switch views & trigger HTMX
                script.
                  function setShelfMode(mode) {
                    const hiddenInput = document.getElementById('shelfMode');
                    if (hiddenInput.value === mode) return;

                    hiddenInput.value = mode;
                    const isRange = mode === 'range';

                    // Toggle container visibility
                    const rangeView = document.getElementById('shelf-range-view');
                    const singleView = document.getElementById('shelf-single-view');
                    
                    rangeView.classList.toggle('hidden', !isRange);
                    singleView.classList.toggle('hidden', isRange);

                    // Disable inputs in hidden view to prevent double field submissions
                    rangeView.querySelectorAll('input').forEach(i => i.disabled = !isRange);
                    singleView.querySelectorAll('input').forEach(i => i.disabled = isRange);

                    // Update active button styling
                    const btnRange = document.getElementById('btn-shelf-range');
                    const btnSingle = document.getElementById('btn-shelf-single');

                    btnRange.className = isRange 
                      ? 'flex-1 font-label-md bg-primary text-on-primary' 
                      : 'flex-1 font-label-md text-on-surface hover:bg-surface-container transition-colors';

                    btnSingle.className = !isRange 
                      ? 'flex-1 font-label-md bg-primary text-on-primary border-l border-outline' 
                      : 'flex-1 font-label-md text-on-surface hover:bg-surface-container transition-colors border-l border-outline';

                    // Dispatch change event on the hidden input so HTMX refreshes the live preview grid
                    hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));

                    // Prevent form submission when buttons are clicked
                    event.preventDefault();
                  }
       
        //- Partition Settings Section
        div
          h3(class="font-label-xl text-label-xl text-on-surface uppercase border-b border-outline-variant pb-2 mb-stack-md mt-stack-lg") Partition Settings
          
          div(class="space-y-stack-md bg-surface-container-low p-4 rounded-DEFAULT border border-outline-variant")
            
            //- Hidden input to serialize partitionMode ('range' | 'single') for Express
            input#partitionMode(
              type="hidden" 
              name="partitionMode" 
              value="none"
            )

            //- Mode Toggle Buttons
            div(class="flex border border-outline rounded-DEFAULT overflow-hidden bg-surface-container-lowest h-10")
              button#btn-partition-range(
                type="button"
                class="flex-1 font-label-md text-on-surface hover:bg-surface-container transition-colors"
                onclick="setPartitionMode('range')"
              ) Range
              
              button#btn-partition-none(
                type="button"
                class="flex-1 font-label-md bg-primary text-on-primary border-l border-outline"
                onclick="setPartitionMode('none')"
              ) None

            //- Range View (Enabled when Range is selected)
            div#partition-range-view(class="hidden grid grid-cols-2 gap-2 pt-2")
              div(class="flex flex-col gap-1")
                label(class="text-[10px] text-on-surface-variant uppercase font-semibold") Start
                input(
                  type="text"
                  name="partitionStart"
                  value="A"
                  disabled
                  class="w-full h-touch-target px-2 border border-outline focus:border-2 focus:border-primary rounded-DEFAULT font-body-md text-center bg-surface-container-lowest"
                )
              div(class="flex flex-col gap-1")
                label(class="text-[10px] text-on-surface-variant uppercase font-semibold") End
                input(
                  type="text"
                  name="partitionEnd"
                  value="Z"
                  disabled
                  class="w-full h-touch-target px-2 border border-outline focus:border-2 focus:border-primary rounded-DEFAULT font-body-md text-center bg-surface-container-lowest"
                )

          
        //- Script to switch modes, disable/enable inputs, and trigger HTMX
        script.
          function setPartitionMode(mode) {
            const hiddenInput = document.getElementById('partitionMode');
            if (hiddenInput.value === mode) return;

            hiddenInput.value = mode;
            const isRange = mode === 'range';
            const rangeView = document.getElementById('partition-range-view');

            // 1. Toggle visibility of the range inputs container
            rangeView.classList.toggle('hidden', !isRange);

            // 2. Enable inputs in Range mode, Disable them in None mode
            // (Disabled inputs are ignored by HTMX/Express during form serialization)
            const inputs = rangeView.querySelectorAll('input');
            inputs.forEach(input => {
              input.disabled = !isRange;
            });

            // 3. Update toggle button styling
            const btnRange = document.getElementById('btn-partition-range');
            const btnNone = document.getElementById('btn-partition-none');

            btnRange.className = isRange 
              ? 'flex-1 font-label-md bg-primary text-on-primary' 
              : 'flex-1 font-label-md text-on-surface hover:bg-surface-container transition-colors';

            btnNone.className = !isRange 
              ? 'flex-1 font-label-md bg-primary text-on-primary border-l border-outline' 
              : 'flex-1 font-label-md text-on-surface hover:bg-surface-container transition-colors border-l border-outline';

            // 4. Dispatch change event to re-trigger HTMX preview grid update
            hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
        //- Directional Arrow — CSS-only segmented control with HTMX preview trigger
        div
          h3(class="font-label-xl text-label-xl text-on-surface uppercase border-b border-outline-variant pb-2 mb-stack-md mt-stack-lg") Directional Arrow
          div(class="flex border border-outline rounded-DEFAULT overflow-hidden bg-surface-container-lowest h-10")
            label(class="flex-1 relative")
              input(type="radio" name="arrowMode" value="none" class="peer sr-only")
              span(class="flex items-center justify-center h-full font-label-md text-on-surface peer-checked:bg-primary peer-checked:text-on-primary transition-colors cursor-pointer") None
            
            label(class="flex-1 relative")
              input(type="radio" name="arrowMode" value="up" class="peer sr-only" checked)
              span(class="flex items-center justify-center h-full gap-1 font-label-md text-on-surface border-l border-outline peer-checked:bg-primary peer-checked:text-on-primary transition-colors cursor-pointer")
                span(class="material-symbols-outlined text-[16px]") arrow_upward
                |  Up
            
            label(class="flex-1 relative")
              input(type="radio" name="arrowMode" value="down" class="peer sr-only")
              span(class="flex items-center justify-center h-full gap-1 font-label-md text-on-surface border-l border-outline peer-checked:bg-primary peer-checked:text-on-primary transition-colors cursor-pointer")
                span(class="material-symbols-outlined text-[16px]") arrow_downward
                |  Down
            
            label(class="flex-1 relative")
              input(type="radio" name="arrowMode" value="both" class="peer sr-only")
              span(class="flex items-center justify-center h-full gap-1 font-label-md text-on-surface border-l border-outline peer-checked:bg-primary peer-checked:text-on-primary transition-colors cursor-pointer")
                span(class="material-symbols-outlined text-[16px]") swap_vert
                |  Both
      //- Fixed action footer — separate request from the live-preview form above.
      div(class="p-margin-mobile border-t border-outline-variant bg-surface")
        div(class="flex gap-2")
          button#generate-button(
            type="button"
            class="flex-1 h-touch-target bg-secondary-container hover:bg-secondary-fixed text-on-secondary-container font-label-xl text-label-xl rounded-DEFAULT flex items-center justify-center gap-2 transition-colors border-2 border-primary"
            onclick="startPrint()"
            disabled=(totalCount || 0) === 0
          )
            span#generate-icon(class="material-symbols-outlined") print
            span#generate-count Generate #{totalCount || 0} Labels
          button#cancel-button(
            type="button"
            class="hidden h-touch-target px-4 bg-error-container text-on-error-container font-label-md rounded-DEFAULT border-2 border-error"
            onclick="cancelPrint()"
          ) Cancel
          button#restart-button(
            type="button"
            class="hidden h-touch-target px-4 bg-surface-container text-on-surface font-label-md rounded-DEFAULT border-2 border-outline"
            onclick="restartPrint()"
          ) Restart
        div#generate-status(class="text-center text-[12px] text-on-surface-variant mt-2")

      script.
        let activeBatchId = null;
        let progressTimer = null;
        function setPrintingState(isPrinting) {
          const button = document.getElementById('generate-button');
          const icon = document.getElementById('generate-icon');
          const cancelButton = document.getElementById('cancel-button');
          const restartButton = document.getElementById('restart-button');
          button.disabled = isPrinting;
          cancelButton.disabled = false;
          button.classList.toggle('opacity-70', isPrinting);
          icon.classList.toggle('animate-spin', isPrinting);
          cancelButton.classList.toggle('hidden', !isPrinting);
          if (isPrinting) restartButton.classList.add('hidden');
        }

        function setRecoveryState(isVisible) {
          document.getElementById('restart-button').classList.toggle('hidden', !isVisible);
        }

        function getLabelLengthError(formData) {
          const plant = String(formData.get('plant') || '').trim();
          const locationType = String(formData.get('locationType') || '').trim();
          const shelfPrefix = String(formData.get('shelfPrefix') || '').trim();
          const shelfEnd = String(formData.get('shelfEnd') || '').trim();
          const shelfStart = String(formData.get('shelfStart') || '').trim();
          const partitionEnd = String(formData.get('partitionEnd') || '').trim();
          const partitionStart = String(formData.get('partitionStart') || '').trim();
          const maxShelf = shelfEnd || shelfStart;
          const maxPartition = partitionEnd || partitionStart;
          let sampleCode = `${plant}_${locationType}_${shelfPrefix}${maxShelf}`;
          if (maxPartition) sampleCode += `-${maxPartition}`;

          if (sampleCode.length > 26) {
            return `Generated barcode code is too long (${sampleCode.length} chars). Maximum limit is 26 characters including underscores and dashes.`;
          }
          return null;
        }

        function syncGenerateAvailability() {
          const button = document.getElementById('generate-button');
          const countText = document.getElementById('generate-count').textContent;
          const hasLabels = !/^Generate 0 Labels$/.test(countText.trim());
          const formData = new FormData(document.getElementById('label-form'));
          const lengthError = getLabelLengthError(formData);
          button.disabled = !hasLabels || Boolean(activeBatchId) || Boolean(lengthError);
          if (!activeBatchId && lengthError) {
            document.getElementById('generate-status').textContent = lengthError;
          }
        }

        document.body.addEventListener('htmx:afterSettle', syncGenerateAvailability);
        syncGenerateAvailability();

        function updateProgress(batch) {
          const remaining = Math.max(batch.total_count - batch.completedCount, 0);
          const count = document.getElementById('generate-count');
          const status = document.getElementById('generate-status');
          const button = document.getElementById('generate-button');

          if (batch.status === 'processing') {
            count.textContent = `Printing.. (${remaining})`;
            status.textContent = `${batch.completedCount} of ${batch.total_count} labels printed`;
            setPrintingState(true);
          } else if (batch.status === 'completed') {
            status.textContent = 'Print completed successfully. Refreshing...';
            window.location.reload();
            return;
          } else if (batch.status === 'paused') {
            count.textContent = 'Failed';
            status.textContent = `${batch.completedCount} of ${batch.total_count} labels printed. ${batch.lastError || 'Printer error.'}`;
            setPrintingState(false);
            setRecoveryState(true);
            activeBatchId = batch.id;
          } else if (batch.status === 'cancelled') {
            count.textContent = 'Resume';
            status.textContent = `Printing paused after ${batch.completedCount} of ${batch.total_count} labels.`;
            setPrintingState(false);
            setRecoveryState(true);
            activeBatchId = batch.id;
          }

          button.onclick = batch.status === 'paused' ? resumeOrRestart : batch.status === 'cancelled' ? resumePrint : startPrint;
        }

        async function pollBatch() {
          if (!activeBatchId) return;
          const response = await fetch(`/labels/batches/${activeBatchId}`);
          if (!response.ok) throw new Error('Unable to read print progress.');
          const batch = await response.json();
          updateProgress(batch);
          if (batch.status === 'processing') {
            progressTimer = setTimeout(pollBatch, 500);
          }
        }

        async function startPrint() {
          if (activeBatchId) return;
          const status = document.getElementById('generate-status');
          try {
            const formData = new URLSearchParams(new FormData(document.getElementById('label-form')));
            const lengthError = getLabelLengthError(formData);
            if (lengthError) throw new Error(lengthError);
            const response = await fetch('/labels/generate', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: formData
            });
            const result = await response.json();
            if (!response.ok) throw new Error(result.error || 'Unable to start printing.');
            activeBatchId = result.batchId;
            setPrintingState(true);
            setRecoveryState(false);
            syncGenerateAvailability();
            await pollBatch();
          } catch (error) {
            setPrintingState(false);
            setRecoveryState(false);
            status.textContent = error.message;
          }
        }

        async function cancelPrint() {
          if (!activeBatchId) return;
          const status = document.getElementById('generate-status');
          document.getElementById('cancel-button').disabled = true;
          clearTimeout(progressTimer);
          status.textContent = 'Cancelling after the current label...';
          try {
            const response = await fetch(`/labels/batches/${activeBatchId}/cancel`, { method: 'POST' });
            const result = await response.json();
            if (!response.ok) throw new Error(result.error || 'Unable to cancel printing.');
            await pollBatch();
          } catch (error) {
            document.getElementById('cancel-button').disabled = false;
            status.textContent = error.message;
          }
        }

        async function resumeOrRestart() {
          const resume = window.confirm('Printing failed. Click OK to resume the batch, or Cancel to start a new print session.');
          if (resume) {
            await resumePrint();
          } else {
            await restartPrint();
          }
        }

        async function resumePrint() {
          if (!activeBatchId) return;
          const response = await fetch(`/labels/batches/${activeBatchId}/resume`, { method: 'POST' });
          if (response.ok) {
            setPrintingState(true);
            await pollBatch();
          }
        }

        async function restartPrint() {
          activeBatchId = null;
          await startPrint();
        }

  //- ===== Bottom Nav (mobile only) =====
  nav(class="md:hidden flex justify-around items-center h-16 bg-surface border-t border-outline-variant fixed bottom-0 w-full z-50")
    a(class="flex flex-col items-center justify-center bg-secondary-container text-on-secondary-container rounded-full px-4 py-1 active:scale-95 transition-transform" href="/")
      span(class="material-symbols-outlined") label
      span(class="font-label-md text-label-md") Generate
    a(class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-container-low active:scale-95 transition-transform px-4 py-1" href="/history")
      span(class="material-symbols-outlined") history
      span(class="font-label-md text-label-md") History
    a(class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-container-low active:scale-95 transition-transform px-4 py-1" href="/settings")
      span(class="material-symbols-outlined") settings
      span(class="font-label-md text-label-md") Settings
