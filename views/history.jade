extends layout

block content
  header(class="w-full top-0 sticky flex items-center justify-between px-margin-mobile md:px-margin-desktop h-touch-target bg-surface border-b border-outline-variant z-50")
    div(class="flex items-center gap-2")
      span(class="material-symbols-outlined text-primary") history
      h1(class="font-headline-md text-headline-md font-bold text-primary") Print History
    nav(class="hidden md:flex gap-4")
      a(class="font-label-md text-label-md flex items-center gap-1 text-on-surface-variant hover:bg-surface-container px-2 py-1 rounded-DEFAULT" href="/")
        span(class="material-symbols-outlined text-[18px]") label
        | Generate
      a(class="font-label-md text-label-md flex items-center gap-1 text-primary hover:bg-surface-container px-2 py-1 rounded-DEFAULT" href="/history")
        span(class="material-symbols-outlined text-[18px]") history
        | History
      a(class="font-label-md text-label-md flex items-center gap-1 text-on-surface-variant hover:bg-surface-container px-2 py-1 rounded-DEFAULT" href="/settings")
        span(class="material-symbols-outlined text-[18px]") settings
        | Settings

  main(class="flex-1 overflow-y-auto bg-surface-container-low p-margin-mobile md:p-margin-desktop")
    div(class="max-w-5xl mx-auto space-y-6")
      div
        p(class="font-label-md text-on-surface-variant uppercase tracking-wide") Operations
        h2(class="font-headline-lg text-headline-lg text-on-surface") Printed batches

      if !history.length
        div(class="bg-surface border border-outline-variant rounded-DEFAULT p-8 text-center text-on-surface-variant") No printed batches yet.
      else
        each day in history
          section(class="space-y-3")
            h3(class="font-title-lg text-title-lg text-primary px-1")= day.dateLabel
            div(class="space-y-2")
              each batch in day.batches
                details(class="bg-surface border border-outline-variant rounded-DEFAULT overflow-hidden")
                  summary(class="list-none cursor-pointer px-4 py-3 flex flex-wrap items-center gap-4 hover:bg-surface-container")
                    div(class="flex-1 min-w-[180px]")
                      div(class="font-title-md text-title-md text-on-surface") Batch ##{batch.id}
                      div(class="text-body-sm text-on-surface-variant") #{batch.plant} / #{batch.locationType}
                    div(class="text-body-sm text-on-surface-variant") #{batch.totalCount} labels
                    if batch.status === 'completed'
                      span(class="px-2 py-1 rounded-full text-label-sm bg-tertiary-container text-on-tertiary-container")= batch.status
                    else if batch.status === 'paused'
                      span(class="px-2 py-1 rounded-full text-label-sm bg-error-container text-on-error-container")= batch.status
                    else
                      span(class="px-2 py-1 rounded-full text-label-sm bg-secondary-container text-on-secondary-container")= batch.status
                    span(class="material-symbols-outlined text-on-surface-variant") expand_more
                  div(class="border-t border-outline-variant px-4 py-4 space-y-3")
                    div(class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-body-sm text-on-surface-variant")
                      div Created: #{batch.createdAtLabel}
                      div Status: #{batch.status}
                    if batch.labels.length
                      div(class="overflow-x-auto")
                        table(class="w-full text-left text-body-sm")
                          thead
                            tr(class="border-b border-outline-variant text-on-surface-variant")
                              th(class="py-2 pr-4 font-label-md") Seq.
                              th(class="py-2 pr-4 font-label-md") Location
                              th(class="py-2 pr-4 font-label-md") Status
                              th(class="py-2 pr-4 font-label-md") Error
                              th(class="py-2 font-label-md") Printed
                          tbody
                            each label in batch.labels
                              tr(class="border-b border-outline-variant last:border-0")
                                td(class="py-2 pr-4")= label.sequenceNo
                                td(class="py-2 pr-4 font-mono")= label.locationCode
                                td(class="py-2 pr-4")= label.status
                                td(class="py-2 pr-4 text-error")= label.errorMessage || '-'
                                td(class="py-2")= label.printedAtLabel

  nav(class="md:hidden flex justify-around items-center h-16 bg-surface border-t border-outline-variant fixed bottom-0 w-full z-50")
    a(class="flex flex-col items-center justify-center text-on-surface-variant px-4 py-1" href="/")
      span(class="material-symbols-outlined") label
      span(class="font-label-md") Generate
    a(class="flex flex-col items-center justify-center bg-secondary-container text-on-secondary-container rounded-full px-4 py-1" href="/history")
      span(class="material-symbols-outlined") history
      span(class="font-label-md") History
    a(class="flex flex-col items-center justify-center text-on-surface-variant px-4 py-1" href="/settings")
      span(class="material-symbols-outlined") settings
      span(class="font-label-md") Settings
