mixin labelCard(label)
  div(class="bg-surface border border-outline-variant p-4 rounded-lg flex flex-col items-center gap-2")
    // Top Arrow (Upward)
    if label.arrow === 'up'
      div(class="flex items-center justify-center text-primary")
        span(class="material-symbols-outlined font-bold") arrow_upward

    // Barcode Container
    div(class="w-full flex flex-col items-center justify-center p-3 border border-dashed border-outline-variant bg-surface-container-lowest")
      svg(class="w-full h-12 text-primary fill-current" viewBox="0 0 100 40" preserveAspectRatio="none")
        rect(x="0" y="0" width="2" height="40")
        rect(x="4" y="0" width="1" height="40")
        rect(x="7" y="0" width="3" height="40")
        rect(x="12" y="0" width="1" height="40")
        rect(x="15" y="0" width="4" height="40")
        rect(x="21" y="0" width="2" height="40")
        rect(x="25" y="0" width="1" height="40")
        rect(x="28" y="0" width="3" height="40")
        rect(x="33" y="0" width="2" height="40")
        rect(x="37" y="0" width="4" height="40")
        rect(x="43" y="0" width="1" height="40")
        rect(x="46" y="0" width="2" height="40")
        rect(x="50" y="0" width="3" height="40")
        rect(x="55" y="0" width="1" height="40")
        rect(x="58" y="0" width="4" height="40")
        rect(x="64" y="0" width="2" height="40")
        rect(x="68" y="0" width="1" height="40")
        rect(x="71" y="0" width="3" height="40")
        rect(x="76" y="0" width="2" height="40")
        rect(x="80" y="0" width="4" height="40")
        rect(x="86" y="0" width="1" height="40")
        rect(x="89" y="0" width="3" height="40")
        rect(x="94" y="0" width="2" height="40")
        rect(x="98" y="0" width="1" height="40")

    // Text Label
    div(class="text-center")
      h2(class="font-label-xl text-label-xl font-bold text-primary")= label.labelString

    // Bottom Arrow (Downward)
    if label.arrow === 'down'
      div(class="flex items-center justify-center text-primary")
        span(class="material-symbols-outlined font-bold") arrow_downward