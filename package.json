{
  "name": "warehouse-label-project",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "v24.19.0"
  },
  "scripts": {
    "start": "node --env-file=.env ./bin/www",
    "check": "node --check app.js && node --check db.js && node --check routes/index.js && node --check routes/history.js && node --check routes/settings.js && node --check services/printQueue.js && node --check printer/print-service.js && node --check middleware/validateLabelForm.js",
    "build:css": "npx tailwindcss -i ./styles/tailwind.css -o ./public/stylesheets/style.css",
    "dev": "concurrently \"npm run watch:server\" \"npm run watch:css\" \"npm run watch:browser\"",
    "watch:css": "npx tailwindcss -i ./styles/tailwind.css -o ./public/stylesheets/style.css --watch",
    "watch:server": "cross-env DEBUG=warehouse-label-project:* nodemon",
    "watch:browser": "wait-on http://localhost:3000 && browser-sync start --config bs-config.js",
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "http-errors": "~1.6.3",
    "jade": "^1.9.2",
    "morgan": "^1.11.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3",
    "wait-on": "^9.1.0"
  }
}
